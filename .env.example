# Owner setup: configure these once on the server. Never use VITE_ for secret keys.
# Existing Gemini settings can be kept when adding Supabase to your .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
PORT=8787

# Supabase Project Settings > API. The publishable/anon key is public; the service key is secret.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# New Supabase server key; SUPABASE_SERVICE_ROLE_KEY also works for a legacy service_role key.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Authentication > Users: copy the UUID of your pre-created owner account, not its email.
ADMIN_USER_ID=

# Set this to the website's origin when you host it. Local development already allows localhost.
APP_URL=http://127.0.0.1:8787

# Optional: enable only after configuring Google in Supabase Authentication > Providers.
GOOGLE_AUTH_ENABLED=false

# Optional broader US search: register at https://developer.adzuna.com/signup
# These credentials stay on the server. Shared cache/quotas conserve the default allowance.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
